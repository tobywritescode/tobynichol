{
  "functions": {
    "api/proxy.js": {
      "runtime": "nodejs20.x"
    }
  },
  "rewrites": [
    {
      "source": "/telemetry",
      "destination": "https://eth-telemetry-grid.vercel.app/index.html"
    },
    {
      "source": "/telemetry/:path*",
      "destination": "https://eth-telemetry-grid.vercel.app/:path*"
    }
  ]
}
